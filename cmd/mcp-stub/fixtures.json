          }
        },
        "required": [
          "payment_id"
        ],
        "type": "object"
      },
      "name": "fetch_payment"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Use this tool to retrieve multiple refunds for a payment. By default, only the last 10 refunds are returned.",
      "inputSchema": {
        "properties": {
          "count": {
            "description": "The number of refunds to fetch for the payment.",
            "type": "number"
          },
          "from": {
            "description": "Unix timestamp at which the refunds were created.",
            "type": "number"
          },
          "payment_id": {
            "description": "Unique identifier of the payment for which refunds are to be retrieved. ID should have a pay_ prefix.",
            "type": "string"
          },
          "skip": {
            "description": "The number of refunds to be skipped for the payment.",
            "type": "number"
          },
          "to": {
            "description": "Unix timestamp till which the refunds were created.",
            "type": "number"
          }
        },
        "required": [
          "payment_id"
        ],
