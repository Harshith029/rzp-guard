  "tools": [
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Use this tool to retrieve the details of a specific payment using its id. Amount returned is in paisa",
      "inputSchema": {
        "properties": {
          "payment_id": {
            "description": "payment_id is unique identifier of the payment to be retrieved.",
