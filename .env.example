# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Razorpay, Test Mode only ---------------------------------------------
# The guard REFUSES any key id that is not rzp_test_*. Used by the live gates
# and by G1.6 evidence verification. Not needed for the trace study.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 4b trace study -------------------------------------------------
RZP_STUDY_PROVIDER=proxy

# UNTRUSTED INSTRUMENTATION, used because it is the credential available.
#
# This endpoint speaks the Anthropic Messages format but is NOT Anthropic: it
# is an intermediary routing to many vendors. It was measured silently serving
# grok-4.6 for a gpt-5.6 request, names no operator, and publishes no retention
# or privacy terms. PROTOCOL.md 4.5 records what the study therefore does and
# does not claim.
#
# The key is deliberately NOT ANTHROPIC_API_KEY: that variable belongs to your
# own tooling, and borrowing it risks billing or leaking the wrong credential.
#
# Send nothing sensitive through it. The study only ever sends the frozen
# prompt, the frozen briefs, synthetic pay_SYN ids and public tool schemas.
RZP_STUDY_PROXY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# RZP_STUDY_PROXY_BASE=https://api.a6api.com   # optional; this is the default

# Direct OpenAI, if a key becomes available. Preferred: it removes the
# model-identity caveat entirely.
# RZP_STUDY_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
