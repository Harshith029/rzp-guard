# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Razorpay, Test Mode only ---------------------------------------------
# The guard REFUSES any key id that is not rzp_test_*. Used by the live gates
# and by G1.6 evidence verification. Not needed for the trace study.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 4b trace study -------------------------------------------------
# Provider: proxy (default) or openai.
RZP_STUDY_PROVIDER=proxy

# The proxy speaks the Anthropic Messages format but is NOT Anthropic: it is a
# third-party endpoint routing to several vendors' models. Its key is
# deliberately NOT ANTHROPIC_API_KEY -- that variable belongs to your own
# tooling, and borrowing it risks billing or leaking the wrong credential.
NIHAL_CUSTOM_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# RZP_STUDY_PROXY_BASE=https://api.a6api.com   # optional; this is the default

# OpenAI direct, only if RZP_STUDY_PROVIDER=openai.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
