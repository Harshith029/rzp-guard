# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Razorpay, Test Mode only ---------------------------------------------
# The guard REFUSES any key id that is not rzp_test_*. Used by the live gates
# and by G1.6 evidence verification. Not needed for the trace study.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 4b trace study -------------------------------------------------
# A DIRECT provider account. An API proxy is not acceptable instrumentation
# here (PROTOCOL.md 4.4): one was tried and silently served grok-4.6 for a
# gpt-5.6 request. A backend free to swap the model can move every measured
# rate without the guard changing at all, because every denominator counts
# calls the agent actually emitted.
RZP_STUDY_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
