# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Razorpay, Test Mode only ---------------------------------------------
# The guard REFUSES any key id that is not rzp_test_*. Used by the live gates
# (live-block) and by G1.6 evidence verification. Not needed for the study.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Phase 4b trace study -------------------------------------------------
# Provider: bedrock (default) or openai.
RZP_STUDY_PROVIDER=bedrock

# Bedrock. Both are required and AWS_REGION has NO default: Bedrock endpoints
# are per-Region, and guessing one would silently change where the traces ran.
# The region must be one where the OpenAI models are offered.
AWS_BEARER_TOKEN_BEDROCK=xxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# OpenAI direct, only if RZP_STUDY_PROVIDER=openai.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
